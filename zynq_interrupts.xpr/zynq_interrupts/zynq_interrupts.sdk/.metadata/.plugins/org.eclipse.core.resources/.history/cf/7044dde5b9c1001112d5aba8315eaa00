#define TMR_LOAD			1000000

XGpio LEDInst, BTNInst, SWSInst;
XScuGic INTCInst;

//XTmrCtr TMRInst;
int led_data;
int btn_value;
int sws_value;
volatile int flag_10ms = 0;

typedef enum {
	Mode_Time = 0,
	Mode_Alarm = 1,
	Mode_StopWatch = 2,
	Mode_Setting = 3
} watchMode;

watchMode current_mode = Mode_Time;

